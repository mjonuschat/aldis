# STM32 ROM DFU bootloader.
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="df11", MODE="0660", GROUP="dialout"

# RP2040 ROM PicoBoot bootloader.
SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="0003", MODE="0660", GROUP="dialout"

# RP2350 ROM PicoBoot bootloader.
SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="000f", MODE="0660", GROUP="dialout"

# Beacon probe DFU bootloader (RevD and RevH).
SUBSYSTEM=="usb", ATTR{idVendor}=="04d8", ATTR{idProduct}=="beac", MODE="0660", GROUP="dialout"
SUBSYSTEM=="usb", ATTR{idVendor}=="04d8", ATTR{idProduct}=="bea1", MODE="0660", GROUP="dialout"

# Bondtech INDX toolboard DFU bootloader. The running firmware has the same ids, so the
# bootloader is told apart by its DFU device class.
SUBSYSTEM=="usb", ATTR{idVendor}=="04d8", ATTR{idProduct}=="e483", ATTR{bDeviceClass}=="fe", MODE="0660", GROUP="dialout"
